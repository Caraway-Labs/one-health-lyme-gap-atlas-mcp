        "selections": {
          "items": {
            "$ref": "#/$defs/Selection"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Selections",
          "type": "array"
        }
      },
      "required": [
        "county_fips",
        "selections"
      ],
      "title": "ProfileArguments",
      "type": "object"
    },
    "outputSchema": "37a54da1f1f80f2452fd38625ec6c7903c9f2e02c1434e7f8b41abe3ddea9437"
  },
