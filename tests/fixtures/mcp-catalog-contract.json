              "not": {
                "required": [
                  "year"
                ]
              },
              "properties": {
                "end_date": {
                  "type": "string"
                },
                "start_date": {
                  "type": "string"
                }
              },
              "required": [
                "start_date",
                "end_date"
              ]
            }
          ],
          "properties": {
            "end_date": {
              "anyOf": [
                {
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "End Date"
            },
            "measure_id": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]*$",
              "title": "Measure Id",
              "type": "string"
            },
            "page_token": {
              "anyOf": [
                {
                  "maxLength": 2048,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Page Token"
            },
            "start_date": {
              "anyOf": [
                {
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Start Date"
            },
            "year": {
              "anyOf": [
                {
                  "maximum": 2100,
                  "minimum": 1900,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Year"
            }
          },
          "required": [
            "measure_id"
          ],
          "title": "Selection",
          "type": "object"
